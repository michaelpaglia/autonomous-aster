[Unit]
Description=Autonomous Cosmic Trader - 24/7 Astrology-Based Crypto Trading Bot
After=network.target

[Service]
Type=simple
User=your-username
WorkingDirectory=/path/to/aster-dex
Environment="PATH=/path/to/venv/bin:/usr/bin:/bin"
ExecStart=/path/to/venv/bin/python main.py
Restart=always
RestartSec=60
StandardOutput=append:/path/to/aster-dex/cosmic_trader.log
StandardError=append:/path/to/aster-dex/cosmic_trader_error.log

# Security
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
