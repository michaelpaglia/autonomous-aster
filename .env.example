# ===========================================
# Autonomous Cosmic Trader - Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# -------------------------------------------
# AsterDEX API Configuration
# -------------------------------------------
# Get these from https://asterdex.com
ASTERDEX_BASE_URL=https://fapi.asterdex.com
ASTERDEX_MAIN_WALLET=your_main_wallet_address_here
ASTERDEX_API_WALLET=your_api_signer_wallet_here
ASTERDEX_PRIVATE_KEY=your_private_key_here
ASTERDEX_API_KEY=your_api_key_here
ASTERDEX_API_SECRET=your_api_secret_here

# -------------------------------------------
# xAI Grok Configuration
# -------------------------------------------
# Get API key from https://x.ai
GROK_API_KEY=your_grok_api_key_here
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4-fast-non-reasoning

# -------------------------------------------
# Trading Configuration
# -------------------------------------------
# How often to check for new trades (minutes)
CHECK_INTERVAL_MINUTES=10

# Trade all available symbols (True) or only TRADING_SYMBOLS in config.py (False)
USE_ALL_SYMBOLS=True

# Leverage settings
LEVERAGE_MIN=10
LEVERAGE_MAX=20

# Balance management
MIN_BALANCE_USD=1
MIN_POSITION_NOTIONAL=5.5

# Risk management
MAX_OPEN_POSITIONS=3
